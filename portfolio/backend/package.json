{
  "name": "@portfolio/backend",
  "version": "1.0.0",
  "private": true,
  "description": "Portfolio REST API Backend (Express + TypeScript + Prisma + Zod)",
  "main": "dist/server.js",
  "scripts": {
    "dev": "NODE_ENV=development node scripts/dev-server.cjs",
    "build": "npx prisma generate && tsc",
    "build:safe": "node scripts/build.cjs",
    "start": "node dist/server.js",
    "deploy:migrate": "npx prisma migrate deploy && npx prisma db seed",
    "lint": "node scripts/lint.cjs",
    "typecheck": "npx tsc --noEmit",
    "prisma:generate": "npx prisma generate",
    "prisma:migrate": "npx prisma migrate dev",
    "prisma:seed": "npx tsx prisma/seed.ts",
    "db:check": "npx tsx scripts/db-check.ts"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.14.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.12.12",
    "eslint": "^8.57.0",
    "prisma": "^5.14.0",
    "tsx": "^4.10.5",
    "typescript": "^5.4.5"
  }
}
