# Server Runtime
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# PostgreSQL Database Connection (Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/portfolio_dev?schema=public"

# Security & CORS
CORS_ORIGIN="http://localhost:5173"
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Administrator Initial Credentials & Authentication Secrets
ADMIN_EMAIL="admin@portfolio.local"
ADMIN_INITIAL_PASSWORD="change_this_secure_password_in_production"
JWT_ACCESS_SECRET="replace-with-minimum-32-character-random-access-secret-key"
JWT_REFRESH_SECRET="replace-with-minimum-32-character-random-refresh-secret-key"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Cloud Storage (Cloudinary / Supabase)
STORAGE_PROVIDER="cloudinary"
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# Logging
LOG_LEVEL="debug"
