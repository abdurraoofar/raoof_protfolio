datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Admin {
  id           String    @id @default(uuid())
  email        String    @unique
  username     String?   @unique
  passwordHash String
  name         String
  role         String    @default("ADMIN")
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("admins")
}

model Profile {
  id               String   @id @default(uuid())
  fullName         String
  headline         String
  bio              String   @db.Text
  aboutParagraph1  String?  @db.Text
  aboutParagraph2  String?  @db.Text
  location         String
  locationFull     String?
  email            String
  phone            String?
  statusBadge      String
  heroHeading      String
  heroSubheading   String   @db.Text
  avatarUrl        String?
  educationShort   String?
  institutionShort String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("profiles")
}

model Project {
  id            String    @id @default(uuid())
  title         String
  slug          String?   @unique
  summary       String    @db.Text
  description   String    @db.Text
  category      String    @default("Web")
  coverImageUrl String
  demoUrl       String?
  githubUrl     String?
  technologies  String[]
  featured      Boolean   @default(false)
  isPublished   Boolean   @default(true)
  displayOrder  Int       @default(0)
  year          String?
  publishedAt   DateTime? @default(now())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([isPublished, displayOrder])
  @@map("projects")
}

model Skill {
  id           String   @id @default(uuid())
  name         String
  category     String
  proficiency  Int      @default(85)
  detail       String?  @db.Text
  iconName     String?
  isVisible    Boolean  @default(true)
  displayOrder Int      @default(0)
  code         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([category, isVisible, displayOrder])
  @@map("skills")
}

model Experience {
  id             String    @id @default(uuid())
  role           String
  company        String
  companyUrl     String?
  period         String?
  location       String?
  employmentType String?
  startDate      DateTime?
  endDate        DateTime?
  isCurrent      Boolean   @default(false)
  description    String?   @db.Text
  highlights     String[]
  displayOrder   Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([displayOrder])
  @@map("experiences")
}

model Education {
  id             String   @id @default(uuid())
  degree         String
  institution    String
  institutionUrl String?
  period         String?
  location       String?
  startYear      Int?
  endYear        Int?
  grade          String?
  details        String?  @db.Text
  displayOrder   Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([displayOrder])
  @@map("educations")
}

model Resume {
  id         String   @id @default(uuid())
  fileName   String
  fileUrl    String
  fileSize   String?
  mimeType   String?  @default("application/pdf")
  version    String?  @default("1.0")
  isActive   Boolean  @default(true)
  uploadedAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("resumes")
}

model SocialLink {
  id           String   @id @default(uuid())
  platform     String
  url          String
  icon         String?
  isVisible    Boolean  @default(true)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([isVisible, displayOrder])
  @@map("social_links")
}

model ContactMessage {
  id         String   @id @default(uuid())
  name       String
  email      String
  subject    String?
  message    String   @db.Text
  status     String   @default("UNREAD")
  replyNotes String?  @db.Text
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([status, createdAt])
  @@map("contact_messages")
}
